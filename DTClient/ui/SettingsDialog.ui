          <item>
           <widget class="QCheckBox" name="UseTlsCheckBox">
            <property name="toolTip">
             <string>Encrypts the connection. The certificate of the server and its host name are always verified. A server that is run with Let's Encrypt certificates usually listens on port 8883 and has to be addressed by the host name of its certificate, not by IP address. A scheme in the server field (ssl://, mqtts://, tls://) also turns TLS on, and then the CA file below is used as well. IPv6 addresses in brackets do not work with TLS.</string>
            </property>
            <property name="text">
             <string>Use TLS (encrypted, certificate verified)</string>
            </property>
           </widget>
          </item>
