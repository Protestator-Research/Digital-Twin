            <item>
             <widget class="QLineEdit" name="CaFileLineEdit">
              <property name="toolTip">
               <string>Optional PEM file with the certificates of the CA that signed the server certificate (a private CA). It is used whenever the connection uses TLS: with the checkbox above or with a TLS scheme (ssl://, mqtts://, tls://) in the server field. If it is set, only these certificates are trusted, not the certificates of the system. Empty: the certificates of the system.</string>
              </property>
              <property name="placeholderText">
               <string>empty: certificates of the system</string>
              </property>
